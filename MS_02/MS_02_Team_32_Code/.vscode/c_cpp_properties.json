{                                       // settings of the Microsoft C/C++ extension
    "configurations": [                 // list of configurations
        {                               // the only configuration
            "name": "Pico",             // name shown in the VS Code status bar
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",  // exact compile flags, written by CMake
            "includePath": [            // folders searched for headers
                "${workspaceFolder}/**",                // this project
                "${userHome}/.pico-sdk/sdk/2.3.1/**"    // the Pico SDK
            ],                          // end of header folders
            "defines": [],              // no extra macros
            "compilerPath": "${userHome}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gcc",  // the compiler used for the Pico
            "cStandard": "c11",         // C11
            "cppStandard": "c++17",     // C++17
            "intelliSenseMode": "linux-gcc-arm"         // parse code the way ARM GCC does
        }                               // end of the configuration
    ],                                  // end of the list
    "version": 4                        // version of this file format
}                                       // end of file
