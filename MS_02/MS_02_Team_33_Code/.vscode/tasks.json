{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure CMake",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/cmake/v4.3.4/bin/cmake.exe",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-DCMAKE_MAKE_PROGRAM=${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe"
            ],
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "Compile Project",
            "type": "process",
            "isBuildCommand": true,
            "command": "${env:USERPROFILE}/.pico-sdk/ninja/v1.13.2/ninja.exe",
            "args": ["-C", "${workspaceFolder}/build"],
            "dependsOn": ["Configure CMake"],
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Project",
            "type": "process",
            "command": "${env:USERPROFILE}/.pico-sdk/picotool/2.3.1/picotool/picotool.exe",
            "args": ["load", "${workspaceFolder}/build/ms02_neural_calibrator.uf2", "-fx"],
            "dependsOn": ["Compile Project"],
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        }
    ]
}
